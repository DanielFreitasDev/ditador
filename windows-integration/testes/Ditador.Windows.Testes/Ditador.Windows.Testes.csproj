<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Os testes do frontend.
    ======================
    Cobrem a única parte dele que tem regra em vez de desenho: a leitura do
    protocolo do canal de controle. O resto — janela, ícone, menu, posição — é
    interação com o Windows, e testá-lo exigiria uma sessão gráfica de verdade;
    esses continuam sendo os roteiros manuais listados no README.

    Vale a pena porque o protocolo é um **contrato** com o backend em Rust, e um
    contrato lido errado falha em silêncio: um campo que vira vazio, um estado
    que vira "pronto" quando devia ser "erro". O lado de lá tem teste para a
    escrita das mesmas linhas (`retrato::tests`); este é o lado da leitura.

    O projeto aponta para o `Ditador.Windows.Nucleo`, e **não** para o aplicativo.
    A primeira versão apontava para o aplicativo — ele compila, os testes passam
    na máquina de quem tem o Windows App Runtime instalado, e o `dotnet test`
    **pendura para sempre** no agente da CI: o executor carregava o assembly do
    WinUI e ficava esperando um runtime gráfico que um servidor de build não tem.
    Foi assim que a separação entre domínio e interface deixou de ser estética e
    virou requisito.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ditador.Windows.Nucleo\Ditador.Windows.Nucleo.csproj" />
  </ItemGroup>

</Project>
